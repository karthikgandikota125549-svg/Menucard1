# MongoDB Connection
MONGO_URI=mongodb://127.0.0.1:27017/foodOrderDB

# Server Port
PORT=5001

# JWT Secret Key (change this to a strong random string in production)
JWT_SECRET=your_jwt_secret_key_here

# JWT Token Expiration
JWT_EXPIRES_IN=1d

# Frontend API URL (used by the React app to connect to the backend)
REACT_APP_API_URL=http://localhost:5001
